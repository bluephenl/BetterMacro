{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterMacro",
  "version": "0.3.2",
  "identifier": "io.bettermacro.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "BetterMacro", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600, "decorations": true, "transparent": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.6",
      "signingIdentity": "-"
    }
  }
}
